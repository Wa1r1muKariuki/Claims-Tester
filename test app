import io
import random

import numpy as np
from PIL import Image, ImageDraw, ImageFilter

import logic as L


def jpeg(im, q=90):
    b = io.BytesIO()
    im.save(b, "JPEG", quality=q)
    return b.getvalue()


def scene(seed, w=1200, h=800):
    rnd = random.Random(seed)
    im = Image.new("RGB", (w, h), (120, 130, 140))
    d = ImageDraw.Draw(im)
    for _ in range(80):
        x, y = rnd.randint(0, w), rnd.randint(0, h)
        d.rectangle((x, y, x + rnd.randint(20, 200), y + rnd.randint(20, 150)),
                    fill=tuple(rnd.randint(0, 255) for _ in range(3)))
    return im


def test_good_photo_passes():
    r = L.check_single(jpeg(scene(1)))
    assert not r["blocking"] and not r["soft"], r


def test_bad_files_rejected():
    assert L.check_single(b"hello world, not an image")["blocking"]
    assert L.check_single(jpeg(scene(1, 300, 200)))["blocking"]                # too small
    assert L.check_single(jpeg(Image.new("RGB", (1200, 800), (90, 90, 90))))["blocking"]  # blank
    assert L.check_single(jpeg(scene(1, 3000, 800)))["blocking"]              # panorama shape
    assert L.check_single(b"x" * (13 * 1024 * 1024))["blocking"]              # too big


def test_soft_quality_flags():
    assert L.check_single(jpeg(scene(2).filter(ImageFilter.GaussianBlur(12))))["soft"]
    dark = Image.eval(scene(3), lambda p: p // 8)
    assert any("dark" in s for s in L.check_single(jpeg(dark))["soft"])


def test_duplicate_detection():
    a, b = L.check_single(jpeg(scene(1)))["hash"], L.check_single(jpeg(scene(1), 60))["hash"]
    c = L.check_single(jpeg(scene(99)))["hash"]
    assert L.hamming(a, b) <= L.DUP_BITS
    assert L.hamming(a, c) > L.DUP_BITS


def test_taxonomy_and_aliases():
    assert L.DAMAGES == ["Scratch", "Dent", "Smashed", "Broken", "Torn", "Dislodged"]
    assert L.normalize("smached", L.DAMAGES) == "Smashed"
    assert L.normalize("HOOD", L.PANELS) == "Hood"
    assert L.normalize("nonsense", L.DAMAGES) is None


def test_report_validation():
    assert L.validate_report("r.pdf", b"%PDF-1.4 ...")["error"] is None
    assert L.validate_report("r.pdf", b"nope")["error"]
    ok = L.validate_report("r.csv", b"Panel,Damage\nHood,smached\nRoof,Dent\n")
    assert ok["items"] == [("Hood", "Smashed"), ("Roof", "Dent")]
    assert L.validate_report("r.csv", b"Panel,Damage\nHood,Melted\n")["error"]
    assert L.validate_report("r.csv", b"a,b\n1,2\n")["error"]
    assert L.validate_report("r.png", b"garbage")["error"]


def test_compare_journeys():
    dets = [{"Panel": "Hood", "Damage": "Dent", "conf": 0.9, "view": "Front", "bbox": [0, 0, 1, 1]},
            {"Panel": "Roof", "Damage": "Scratch", "conf": 0.7, "view": "Left", "bbox": [0, 0, 1, 1]}]
    df = L.compare([("Hood", "Dent"), ("Trunk", "Torn")], dets, minor=True)
    st = dict(zip(zip(df.Panel, df.Damage), df.Status))
    assert st[("Hood", "Dent")] == "Matched"
    assert st[("Trunk", "Torn")] == "Needs review"
    assert st[("Roof", "Scratch")] == "Listed only"   # not flagged in Journey 1
    assert L.outcome(df) == "Needs review"
    df2 = L.compare([("Hood", "Dent")], dets, minor=False)
    assert dict(zip(df2.Panel, df2.Status))["Roof"] == "Info" and L.outcome(df2) == "Matched"


def test_mock_detector_deterministic_and_annotate():
    data = jpeg(scene(5))
    a, b = L.detect_damage("Front", data), L.detect_damage("Front", data)
    assert a == b
    assert L.annotate(data, a).size == (1200, 800)


